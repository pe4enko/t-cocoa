# Токен Telegram-бота из @BotFather.
# Обязателен всегда: без него бот не запустится.
BOT_TOKEN=123456:replace_me

# Код базового актива MOEX для автопоиска ближайшего активного контракта на какао.
# Используется, когда в команде не передан конкретный тикер MOEX.
RU_COCOA_ASSET_CODE=COCOA

# Fallback-символ курса доллара из TradingView для обычного режима.
# Используется, когда LIVE_QUOTES_ENABLED=false или T-Bank недоступен.
TV_USDRUBF_SYMBOL=USDRUBF

# Необязательный ручной override зарубежного тикера какао в TradingView.
# Используется всегда, если заполнен: бот возьмет именно этот тикер.
# Если пусто, бот сам подберет ICE-контракт по сроку локального контракта.
TV_WORLD_COCOA_SYMBOL=

# Continuous-тикер ICE cocoa.
# Используется только как запасной fallback, если не удалось определить точный ICE-контракт.
TV_WORLD_COCOA_CONTINUOUS_SYMBOL=ICEUS:CC1!

# Кеш официального ICE expiry calendar до конца текущего дня по Москве.
# true — не запрашивать таблицу соответствия слишком часто.
# false — запрашивать официальный календарь ICE при каждом расчете.
ICE_COCOA_EXPIRY_CACHE_ENABLED=true

# Резервная таблица соответствия ICE-контрактов на случай ошибки запроса к официальному ICE expiry calendar.
# Формат записи: CONTRACT|YYYY-MM-DD|TRADINGVIEW_SYMBOL;...
# Пустое значение означает, что при ошибке запроса бот сразу перейдет к месячному fallback.
# Месячный fallback — это упрощенная логика без официального календаря ICE:
# бот берет ближайший стандартный месяц серии March/May/July/September/December по сроку локального контракта.
ICE_COCOA_EXPIRY_FALLBACK_ENTRIES=May26|2026-05-14|ICEUS:CCK2026;Jul26|2026-07-17|ICEUS:CCN2026;Sep26|2026-09-16|ICEUS:CCU2026;Dec26|2026-12-16|ICEUS:CCZ2026;Mar27|2027-03-16|ICEUS:CCH2027

# Настройки модели расчетного базиса.
# Если FAIR_BASIS_RATE_PCT пустой, бот берет текущую ключевую ставку ЦБ.
# Если заполнен, используется это значение и запрос к ЦБ не нужен.
FAIR_BASIS_RATE_PCT=

# База дней для carry-модели.
# Обычно оставляют 360, если нет отдельной методологии расчета.
FAIR_BASIS_DAY_COUNT=360

# URL страницы ЦБ для автоматического получения ставки.
# Используется только когда FAIR_BASIS_RATE_PCT пустой.
CBR_KEY_RATE_URL=https://www.cbr.ru/eng/hd_base/KeyRate/?UniDbQuery.Posted=True

# Кеш ставки ЦБ до конца текущего дня по Москве.
# true — экономит запросы, false — запрашивает ставку заново при каждом расчете.
CBR_KEY_RATE_CACHE_ENABLED=true

# Окно торгов внешнего рынка по московскому времени.
# Обычно бот берет официальные часы ICE cocoa с сайта ICE и сам учитывает DST.
# Эти значения используются как ручной fallback из .env, если страница ICE недоступна.
# Если FOREIGN_MARKET_SESSION_CHECK_ENABLED=true, бот не считает во время этой сессии.
# Если false, расчет разрешен и во время торгов, с использованием последнего доступного закрытия.
FOREIGN_MARKET_SESSION_CHECK_ENABLED=true
FOREIGN_OPEN_TIME_MSK=11:45
FOREIGN_CLOSE_TIME_MSK=20:30

# Полные нерабочие праздники внешнего рынка в формате YYYY-MM-DD через запятую.
# Используется при определении последнего валидного закрытия внешнего рынка.
# Если значение пустое, учитываются только выходные.
FOREIGN_MARKET_HOLIDAYS_MSK=2026-01-01,2026-01-19,2026-02-16,2026-04-03,2026-05-25,2026-06-19,2026-07-03,2026-09-07,2026-11-26,2026-12-25

# Настройки TradingView для поиска зарубежного закрытия.
# TV_SESSION_ID необязателен: если пустой, используется анонимное подключение к TradingView.
TV_TIMEFRAME_MINUTES=1
TV_LOOKBACK_BARS=3000
TV_SESSION_ID=

# Кеш зарубежного закрытия до следующего открытия внешнего рынка.
# true — не дергать TradingView лишний раз до новой сессии.
# В кеш попадает только подтвержденное зарубежное закрытие на финальной минутной свече.
TV_WORLD_CLOSE_CACHE_ENABLED=true

# Live-режим котировок для локального какао и USDRUBF через T-Bank Invest API.
# Если false, бот всегда использует старые источники: MOEX ISS и TradingView.
LIVE_QUOTES_ENABLED=true

# Токен T-Bank Invest API.
# Нужен только если LIVE_QUOTES_ENABLED=true.
# Если пустой, live-режим автоматически откатится на старые источники.
TBANK_API_TOKEN=

# Базовый URL T-Bank Invest API.
# Обычно менять не нужно.
TBANK_API_BASE_URL=https://invest-public-api.tbank.ru/rest

# Необязательный пользовательский CA-сертификат для запросов в T-Bank.
# Используется только для запросов в T-Bank.
# Если пустой, используется обычная системная проверка сертификатов.
TBANK_CA_CERT_PATH=certs/TINKOFFBANK-ROOTCA.pem

# Временный обход проблем с TLS-цепочкой. Оставляйте true, если нет явной причины поставить false.
# Если false, проверка TLS-сертификата для T-Bank отключается.
# Используется только для запросов в T-Bank.
TBANK_TLS_VERIFY_ENABLED=true

# Параметры фьючерсов T-Bank.
# Используются только в live-режиме.
# Обычно менять не нужно, если не меняется тикер или схема поиска у T-Bank.
TBANK_FUTURES_CLASS_CODE=SPBFUT
TBANK_USDRUB_SYMBOL=USDRUBF
TBANK_ORDERBOOK_DEPTH=1

# Базовый URL MOEX ISS для fallback-котировок и метаданных контрактов.
# Используется всегда для поиска локального контракта, а также как fallback по цене.
MOEX_ISS_BASE_URL=https://iss.moex.com

# Пороги торгового сигнала. Бот одновременно учитывает отклонение в рублях и процентах.
# Если увеличить значения, сигнал станет более консервативным.
# Если уменьшить — более чувствительным.
SIGNAL_NEUTRAL_SPREAD_RUB=2.00
SIGNAL_NEUTRAL_SPREAD_PCT=0.7
SIGNAL_CAUTIOUS_SPREAD_RUB=2.80
SIGNAL_CAUTIOUS_SPREAD_PCT=1.0
SIGNAL_STRONG_SPREAD_RUB=4.90
SIGNAL_STRONG_SPREAD_PCT=1.75

# Необязательный список разрешенных Telegram chat_id через запятую.
# Если пусто, бот отвечает во всех чатах, где он доступен.
BOT_ALLOWED_CHAT_IDS=
